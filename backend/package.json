{
  "name": "e-commerce-backend",
  "version": "1.0.0",
  "description": "Backend services for Intermediate E-Commerce platform",
  "main": "dist/app.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "nodemon src/app.ts",
    "typecheck": "tsc --noEmit",
    "audit:security": "npm audit --audit-level=high",
    "bootstrap:admin": "ts-node src/scripts/bootstrapAdmin.ts",
    "verify:security": "ts-node src/scripts/verifySecurity.ts"
  },
  "dependencies": {
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.3.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^12.7.0",
    "multer": "^2.2.0",
    "node-cache": "^5.1.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "uuid": "^14.0.1",
    "winston": "^3.13.0",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mssql": "^12.3.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.12",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
