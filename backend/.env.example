# Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# CORS & Security
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Database Configuration
DB_USER=sa
DB_PASSWORD=YourSecurePassword123
DB_SERVER=localhost
DB_DATABASE=E_Commerce_DB
DB_PORT=1433
DB_TRUST_SERVER_CERTIFICATE=true

# Authentication Configuration
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_EXPIRY=15m

# Customer Email Service (Optional - logs to console if unconfigured)
EMAIL_FROM=NexoraHub <noreply@nexorahub.com>
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password
EMAIL_SECURE=false

# Payment Gateway (Optional - defaults to 'simulated')
# Values: simulated | razorpay | stripe
PAYMENT_GATEWAY=simulated
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
