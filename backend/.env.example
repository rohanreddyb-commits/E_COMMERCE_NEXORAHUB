# =============================================================================
# NexoraHub Backend Configuration
#
# Copy to .env and fill in real values. NEVER commit .env.
# Every secret below MUST be regenerated per environment — the values here are
# empty or illustrative on purpose, and config/env.ts refuses to boot if a
# known placeholder is detected.
# =============================================================================

# --- Server ------------------------------------------------------------------
# Default port for this API. The two frontends run on fixed, different ports:
#   Frontend       (admin console)    -> http://localhost:3000
#   Frontend_Node  (customer storefront) -> http://localhost:3001
#   backend        (this app)         -> http://localhost:5000 (this PORT)
PORT=5000
# development | production. Production enforces stricter checks (see below).
NODE_ENV=development
LOG_LEVEL=info

# --- CORS & Rate Limiting -----------------------------------------------------
# Comma-separated allow-list of browser origins. Must list BOTH frontend
# ports above, or requests from whichever one is missing will be rejected.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
# Requests per window per IP. Hard-capped at 1000 by config/env.ts so that a
# misconfiguration cannot disable brute-force protection.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# --- Database -----------------------------------------------------------------
# Use a least-privilege application login, NOT `sa`. The application account
# needs SELECT/INSERT/UPDATE/DELETE on the app schema and nothing more;
# migrations should run under a separate, privileged credential.
DB_USER=nexora_app
# 32+ characters from a secret manager.
DB_PASSWORD=
DB_SERVER=localhost
DB_DATABASE=NexoraHub_DB
DB_PORT=1433
# MUST be false in production — env.ts throws at boot otherwise. Disabling
# certificate validation exposes the DB connection to interception.
DB_TRUST_SERVER_CERTIFICATE=false

# --- Authentication -----------------------------------------------------------
# Two INDEPENDENT keys so an admin token can never be replayed as a customer
# token or vice versa. Minimum 32 bytes each; boot fails otherwise.
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ADMIN_SECRET=
# Access-token lifetime. Keep short — long sessions ride the rotating refresh
# token, and revocation is checked against CustomerSessions on every request.
JWT_EXPIRY=15m
JWT_ISSUER=nexora-api

# --- Migrations ----------------------------------------------------------------
# Schema migrations do NOT run automatically when NODE_ENV=production.
# Set to true for a single deploy to apply them, then unset.
RUN_MIGRATIONS=false

# --- Email (optional — logs a delivery notice to the logger if unconfigured) ---
EMAIL_FROM=NexoraHub <noreply@nexorahub.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_SECURE=false

# --- Payment Gateway ------------------------------------------------------------
# 'simulated' approves every payment and is REFUSED at boot when
# NODE_ENV=production. Use a real gateway for anything customer-facing.
# Values: simulated | razorpay
PAYMENT_GATEWAY=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- First-admin bootstrap ------------------------------------------------------
# Consumed ONLY by `npm run bootstrap:admin`, which an operator runs once by
# hand. No administrator account is ever seeded automatically.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
