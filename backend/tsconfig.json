{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "lib": ["es2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "ts-node": {
    // Load every file in "include", not just those reached through imports, so
    // the ambient Express augmentation in src/core/types/express.d.ts (req.customer,
    // req.requestId) is registered. Without this `npm run dev` fails to compile
    // even though `npm run build` succeeds.
    "files": true
  }
}
