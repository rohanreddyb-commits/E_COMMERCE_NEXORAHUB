# =============================================================================
# NexoraHub Admin Frontend (Frontend/) — Configuration
#
# Copy to .env and adjust if needed. This app is the internal admin console
# and always talks to the LEGACY /api root on the backend (never
# /api/v1/customer).
#
# Fixed local dev/start port: 3000 (see package.json "dev"/"start" scripts,
# which pass `-p 3000` explicitly so it never collides with the customer
# frontend on 3001). If you deploy behind a platform that injects its own
# PORT (Render, Railway, etc.), override the start script for that
# environment instead of relying on this file for the port.
# =============================================================================

# Backend API root (no trailing slash). Must match the backend's PORT
# (backend/.env, default 5000) and be included in the backend's CORS_ORIGIN.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
